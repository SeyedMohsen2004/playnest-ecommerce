DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The console adapter never exposes or delivers OTPs; registration returns 503.
# Use it only to exercise failure handling locally. Mock delivery in automated tests.
SMS_PROVIDER=console
SMS_CONSOLE_ALLOWED=True
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
REFRESH_COOKIE_NAME=playnest_refresh
REFRESH_COOKIE_PATH=/api/v1/
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=False
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/zarinpal/callback/
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media
INTERNAL_API_BASE_URL=http://api:8000/api/v1

# Optional self-hosted Umami analytics (all values are public build configuration).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=
NEXT_PUBLIC_UMAMI_ENABLE_PERFORMANCE=false

# Production payment values:
# ZARINPAL_SANDBOX=False
# ZARINPAL_CALLBACK_URL=https://api.example.invalid/api/v1/payments/zarinpal/callback/
# FRONTEND_BASE_URL=https://shop.example.invalid

POSTGRES_DB=playnest
POSTGRES_USER=playnest
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

API_PORT=8000
FRONTEND_PORT=3000
