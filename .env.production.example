# Copy this file to .env.production and replace every placeholder.
# Never commit .env.production. Values marked PRIVATE must be protected.

# Images and host bindings (non-secret)
PRODUCTION_COMPOSE_PROJECT_NAME=playnest-production
API_IMAGE=playnest-api:production
FRONTEND_IMAGE=playnest-frontend:production
PRODUCTION_BIND_ADDRESS=127.0.0.1
PRODUCTION_API_PORT=8000
PRODUCTION_FRONTEND_PORT=3000

# Public browser and routing values (PUBLIC)
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api/v1
FRONTEND_BASE_URL=https://shop.example.invalid
DJANGO_ALLOWED_HOSTS=api.example.invalid
CSRF_TRUSTED_ORIGINS=https://shop.example.invalid,https://api.example.invalid
CORS_ALLOWED_ORIGINS=https://shop.example.invalid
ZARINPAL_CALLBACK_URL=https://api.example.invalid/api/v1/payments/zarinpal/callback/

# Django and proxy security policy (non-secret)
DJANGO_SECURE_SSL_REDIRECT=True
# Start at 0 until HTTPS is verified, then increase deliberately.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Enable only when a trusted proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=True

# Django secret (PRIVATE)
DJANGO_SECRET_KEY=replace-with-a-long-unique-random-production-secret

# PostgreSQL credentials (PRIVATE)
POSTGRES_DB=replace-with-production-database-name
POSTGRES_USER=replace-with-production-database-user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# SMS integration (API key is PRIVATE)
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=replace-with-production-kavenegar-api-key
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=replace-with-production-template-name

# Payment integration (merchant ID is PRIVATE)
ZARINPAL_MERCHANT_ID=replace-with-production-zarinpal-merchant-id
ZARINPAL_SANDBOX=False

# Gunicorn tuning (non-secret)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_ACCESS_LOGFILE=-
GUNICORN_ERROR_LOGFILE=-
