# Copy this file to .env.production and replace every placeholder.
# Never commit .env.production. Values marked PRIVATE must be protected.

# Images and host bindings (non-secret)
PRODUCTION_COMPOSE_PROJECT_NAME=playnest-production
PRODUCTION_POSTGRES_VOLUME_NAME=playnest-production-postgres-data
PRODUCTION_STATIC_PATH=./backend/staticfiles
PRODUCTION_MEDIA_PATH=./backend/media
API_IMAGE=playnest-api:production
FRONTEND_IMAGE=playnest-frontend:production
PRODUCTION_BIND_ADDRESS=127.0.0.1
PRODUCTION_API_PORT=8000
PRODUCTION_FRONTEND_PORT=3000

# Public browser and routing values (PUBLIC)
NEXT_PUBLIC_API_BASE_URL=https://shop.example.invalid/api/v1
NEXT_PUBLIC_MEDIA_BASE_URL=https://shop.example.invalid/media
# Server-side metadata and sitemap requests use the private Compose network.
INTERNAL_API_BASE_URL=http://api:8000/api/v1
FRONTEND_BASE_URL=https://shop.example.invalid
DJANGO_ALLOWED_HOSTS=shop.example.invalid
CSRF_TRUSTED_ORIGINS=https://shop.example.invalid,https://api.example.invalid
CORS_ALLOWED_ORIGINS=https://shop.example.invalid
ZARINPAL_CALLBACK_URL=https://shop.example.invalid/api/v1/payments/zarinpal/callback/

# Optional self-hosted Umami analytics (PUBLIC build-time values).
# Leave the script URL or website ID blank to disable analytics completely.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=shop.example.invalid,www.shop.example.invalid
NEXT_PUBLIC_UMAMI_ENABLE_PERFORMANCE=false

# Django and proxy security policy (non-secret)
DJANGO_SECURE_SSL_REDIRECT=False
# Start at 0 until HTTPS is verified, then increase deliberately.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Enable only when a trusted proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=True

# Django secret (PRIVATE)
DJANGO_SECRET_KEY=replace-with-a-long-unique-random-production-secret

# PostgreSQL credentials (PRIVATE)
POSTGRES_DB=replace-with-production-database-name
POSTGRES_USER=replace-with-production-database-user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Dormant OTP compatibility endpoints fail closed while disabled. Normal
# storefront registration never invokes SMS.
SMS_PROVIDER=disabled
SMS_CONSOLE_ALLOWED=False
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=

# Payment integration (merchant ID is PRIVATE)
ZARINPAL_MERCHANT_ID=replace-with-production-zarinpal-merchant-id
ZARINPAL_SANDBOX=False

# Gunicorn tuning (non-secret)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_ACCESS_LOGFILE=-
GUNICORN_ERROR_LOGFILE=-
