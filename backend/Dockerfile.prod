FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /build
COPY requirements-build.txt requirements.prod.txt ./
RUN python -m pip install --require-hashes -r requirements-build.txt \
    && python -m pip install \
        --require-hashes \
        --no-build-isolation \
        -r requirements.prod.txt \
    && python -m pip check \
    && python -m pip uninstall --yes pip setuptools wheel


FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}" \
    GUNICORN_BIND="0.0.0.0:8000" \
    GUNICORN_WORKERS="3" \
    GUNICORN_TIMEOUT="60" \
    GUNICORN_GRACEFUL_TIMEOUT="30" \
    GUNICORN_ACCESS_LOGFILE="-" \
    GUNICORN_ERROR_LOGFILE="-"

RUN python -m pip uninstall --yes pip setuptools wheel \
    && groupadd --gid 10001 app \
    && useradd \
        --uid 10001 \
        --gid app \
        --no-create-home \
        --shell /usr/sbin/nologin \
        app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --chown=app:app . .

RUN mkdir -p /app/staticfiles /app/media \
    && chown -R app:app /app/staticfiles /app/media

USER app

EXPOSE 8000
STOPSIGNAL SIGTERM

CMD ["sh", "-c", "exec gunicorn config.wsgi:application --bind \"$GUNICORN_BIND\" --workers \"$GUNICORN_WORKERS\" --timeout \"$GUNICORN_TIMEOUT\" --graceful-timeout \"$GUNICORN_GRACEFUL_TIMEOUT\" --access-logfile \"$GUNICORN_ACCESS_LOGFILE\" --error-logfile \"$GUNICORN_ERROR_LOGFILE\" --capture-output"]
